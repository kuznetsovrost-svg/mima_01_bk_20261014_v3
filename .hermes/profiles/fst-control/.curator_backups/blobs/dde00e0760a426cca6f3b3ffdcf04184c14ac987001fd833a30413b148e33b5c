## Реализация

```python
def classify_amount_delta(delta: float, cfg: dict) -> str:
    """Δ > substantial_max → critical, > informational_max → substantial, > 0 → informational."""
    if delta <= 0:
        return "normal"
    if delta > cfg["substantial_max"]:
        return "critical"
    if delta > cfg["informational_max"]:
        return "substantial"
    return "informational"


def format_amount_short(value: float) -> str:
    """Форматирует сумму в формате 'X,YZZ млн. руб.' (3 знака после запятой)."""
    mln = value / 1_000_000
    if abs(mln - round(mln)) < 0.0005:
        return f"{int(round(mln))} млн. руб."
    formatted = f"{mln:.3f}".rstrip("0").rstrip(".")
    return f"{formatted.replace('.', ',')} млн. руб."
```

