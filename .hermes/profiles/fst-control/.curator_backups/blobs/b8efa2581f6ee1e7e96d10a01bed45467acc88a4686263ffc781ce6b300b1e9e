<!DOCTYPE html>
<html lang="ru">
<!--
  templates/report.html
  Generated by fst-project-health v1.0.19 (2026-09-23).
  Source of truth: SKILL.md::description + CHANGELOG.md (root of skill).

  v1.0.19: «Слепок от:» показывается ТОЛЬКО если MD собран
  снепшот-генератором (snap-md / snapshot / from-md-snapshot).
  Для live-прогона (generator="fst-project-health") поле
  snapshot_timestamp в YAML отсутствует → «Слепок от:» не появляется.
  В live-режиме остаётся только «Отчёт создан: <HH:MM:SS>».

  ВНИМАНИЕ — этот шаблон определяет «видимую» часть HTML-отчёта.
  Любое изменение визуально поменяет артефакт. Diff по `<table class='tbl` /
  `<details class='indicator-details` / `<tr...>` — обязателен после правок.
-->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- generator meta — помогает при отладке/грепации raw HTML -->
    <meta name="generator" content="fst-project-health v1.0.19">
    <title>Отчёт о здоровье проекта {{ project_code }}</title>
</head>
<body>
<div class="report-container">

    <!-- ============================================================ -->
    <!-- HEADER: левая синяя панель + правый круглый индикатор       -->
    <!-- ============================================================ -->
    <div class="report-header">
        <div class="report-header-text">
            <div class="report-header-prefix">Общая оценка здоровья проекта</div>
            <div class="report-header-title">{{ project_name }}</div>
            <div class="report-header-meta"><b>Target:</b> {{ project_code }} (ProjectId={{ project_id }})</div>
            <div class="report-header-meta"><b>Отчёт создан:</b> {{ now }}</div>
            <div class="report-header-meta"><b>MCP:</b> PMForesight MCP v3.2.4{{ snapshot_timestamp }}</div>
        </div>
        <div class="report-indicator">
            <div class="report-indicator-circle" data-status="{{ verdict_status }}">
                <div class="verdict-text">{{ verdict_text }}</div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- 6 ТАБЛИЦ-ОТКРЫВАШЕК (разделы 3, 4, 5, 6-indicators, 6-finance, 7)        -->
    <!-- <details> раскрывает контент — НЕ затеняет, а сдвигает               -->
    <!-- Правильный порядок: 3 → 4 → 5 → 6 (показатели) → 6 (финансы) → 7  -->
    <!-- ============================================================ -->

    <!-- tbl1 = раздел 3 (КТ сроки) — открыт по умолчанию -->
    <details class="variant-tbl" open>
        <summary>
            <span class="tbl-name">Замечания по срокам:</span>
            <span class="tbl-preview">{{ section_3_preview }}</span>
        </summary>
        <div class="tbl-content">
            {{ section_3_content }}
        </div>
    </details>

    <!-- tbl2 = раздел 4 (полнота) -->
    <details class="variant-tbl">
        <summary>
            <span class="tbl-name">Полнота заполнения проекта:</span>
            <span class="tbl-preview">{{ section_4_preview }}</span>
        </summary>
        <div class="tbl-content">
            {{ section_4_content }}
        </div>
    </details>

    <!-- tbl3 = раздел 5 (актуальность прогнозов) -->
    <details class="variant-tbl">
        <summary>
            <span class="tbl-name">Актуальность прогнозов:</span>
            <span class="tbl-preview">{{ section_5_preview }}</span>
        </summary>
        <div class="tbl-content">
            {{ section_5_content }}
        </div>
    </details>

    <!-- ============================================================ -->
    <!-- SECTION 6: Показатели проекта (16 индикаторов)               -->
    <!-- Между 5 (Актуальность прогнозов) и 7 (Финансовый статус)     -->
    <!-- Нумерация v1.0.19: раздел 6 = «Показатели», 7 = «Финансы», 8 = «Тех. данные» -->
    <!-- ============================================================ -->
    <details class="variant-tbl" id="section_6_indicators" open>
        <summary>
            <span class="tbl-name">Показатели проекта:</span>
            <span class="tbl-preview">{{ section_6_preview }}</span>
        </summary>
        <div class="tbl-content">
            {{ section_6_content }}
        </div>
    </details>

    <!-- tbl4 = раздел 7 (финансы) — нумерация v1.0.19 -->
    <details class="variant-tbl">
        <summary>
            <span class="tbl-name">Финансовый статус проекта:</span>
            <span class="tbl-preview">{{ section_7_preview }}</span>
        </summary>
        <div class="tbl-content">
            {{ section_7_content }}
        </div>
    </details>

    <!-- tbl5 = раздел 8 (технические данные) — нумерация v1.0.19 -->
    <details class="variant-tbl">
        <summary>
            <span class="tbl-name">Технические данные отчёта:</span>
            <span class="tbl-preview">{{ section_8_preview }}</span>
        </summary>
        <div class="tbl-content">
            {{ section_8_content }}
        </div>
    </details>

    <!-- ============================================================ -->
    <!-- FOOTER                                                       -->
    <!-- ============================================================ -->
    <div class="report-footer">
        Сгенерировано скиллом <b>fst-project-health</b> · {{ project_code }}
        (ProjectId={{ project_id }}) · MCP PMForesight v3.2.4
    </div>

</div>
</body>
</html>