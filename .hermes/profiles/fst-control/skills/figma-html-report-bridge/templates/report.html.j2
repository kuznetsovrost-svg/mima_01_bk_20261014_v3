<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>{{REPORT_TITLE}}</title>
<style>
  /* === Base === */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif; color: #232326; background: #f0f0f0; padding: 20px; }

  /* === Frame === */
  .report-frame { background: #ffffff; border: 1px solid #D1CFD7; max-width: 1600px; margin: 0 auto; }

  /* === Report Header (may be the only header if app-header is absent) === */
  .report-header {
    padding: 10px 15px;
    background: #2563EB;
    color: #FFFFFF;
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: center;
  }
  .report-header-text {
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: center;
  }
  .report-header-left {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .report-title { font-size: 30px; font-weight: 700; color: #FFFFFF; line-height: 1.1; }
  .report-project { font-size: 18px; color: #FFFFFF; line-height: 1.2; }
  .report-meta { font-size: 11px; color: #DBEAFE; line-height: 1.3; }

  /* === Indicator (variant component in Figma) === */
  .indicator {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: #D1D5DB;       /* default unknown */
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 13px;
    text-align: center;
    padding: 16px;
    flex-shrink: 0;
    line-height: 1.2;
  }
  /* variant-state classes (P11: text from variant, color from Figma variant definition) */
  .indicator-critical { background: #FCA5A5; color: #7F1D1D; }       /* red bg, dark red text */
  .indicator-substantial { background: #FEF3C7; color: #92400E; }   /* yellow bg, brown text */
  .indicator-normal { background: #DCFCE7; color: #166534; }        /* green bg, dark green text */

  /* === Tables === */
  table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid #D1CFD7;
    font-size: 11px;
  }
  /* Summary bar — first row of thead */
  .table-summary {
    background: #F3F4F6;        /* default neutral gray */
    color: #4B5563;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 24px;
    text-align: left;
    border-bottom: 1px solid #D1CFD7;
    line-height: 1.3;
  }
  /* variant-state classes for summary */
  .table-summary.sick { background: #FCA5A5; color: #7F1D1D; }
  .table-summary.warning { background: #FEF3C7; color: #92400E; }

  /* Head row */
  thead th {
    background: #2563EB;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 11px;
    padding: 0 8px;
    height: 30px;
    text-align: center;
    border-right: 1px solid #1E40AF;
    line-height: 1;
  }
  thead th:last-child { border-right: none; }
  thead th.left { text-align: left; }

  /* Body rows */
  tbody tr { border-bottom: 1px solid #D1CFD7; }
  tbody td {
    padding: 0 8px;
    height: 30px;
    border-right: 1px solid #D1CFD7;
    vertical-align: middle;
    line-height: 1;
  }
  tbody td:last-child { border-right: none; }
  tbody td.center { text-align: center; }
  tbody td.left { text-align: left; }

  /* Row status colors */
  tbody tr.critical { background: #FEE2E2; color: #991B1B; }
  tbody tr.warning { background: #FEF3C7; color: #92400E; }
  tbody tr.healthy { background: #DCFCE7; color: #166534; }
  tbody tr.neutral { background: #F9FAFB; color: #232326; }

  /* === Footer === */
  .report-footer {
    padding: 12px 24px;
    background: #ffffff;
    font-size: 10px;
    color: #6B7280;
    text-align: center;
    border-top: 1px solid #D1CFD7;
    line-height: 1.3;
  }
</style>
</head>
<body>

<div class="report-frame" id="report-frame">

  <!--
    NOTE: `app-header` is OPTIONAL. If the user's Figma Frame does NOT have one
    (e.g. they deleted it in iteration 6), omit this block entirely. See P14.
  -->
  <!-- <div class="app-header" id="app-header">{{APP_TITLE}}</div> -->

  <div class="report-header" id="report-header">
    <div class="report-header-text">
      <div class="report-header-left">
        <div class="report-title">{{REPORT_TITLE}}</div>
        <div class="report-project">{{PROJECT_NAME}}</div>
        <div class="report-meta">{{REPORT_META}}</div>
      </div>
      <!--
        Indicator variant class — set by extractor from the instance's
        componentProperties.State.value:
          State=critical      → class="indicator indicator-critical"
          State=substantial   → class="indicator indicator-substantial"
          State=normal        → class="indicator indicator-normal"
        The TEXT inside is also from the variant (P11), not from instance.
        Use <br> not \n (P17).
      -->
      <div class="indicator indicator-{{INDICATOR_STATE}}" id="indicator">{{INDICATOR_TEXT}}</div>
    </div>
  </div>

  <!--
    For each section, use a single <table> with thead + tbody.
    The FIRST <tr> of thead is the summary bar (colspan over all head cols).
    The SECOND <tr> of thead is the column headers.
    Subsequent <tr> are data rows.

    CRITICAL: inline `style="width: Npx"` on every <th> and <td>.
    Sum per row MUST = 1562 (use calibrate_html_widths.py).
    See P2 + P12.
  -->
  <table id="tbl-section-3" data-section="section-3" data-source="TBL3">
    <thead>
      <tr>
        <th colspan="5" class="table-summary">{{S3_SUMMARY}}</th>
      </tr>
      <tr>
        <th class="center" style="width: 40px;">#</th>
        <th class="center" style="width: 90px;">Код</th>
        <th class="left"   style="width: 952px;">Наименование</th>
        <th class="center" style="width: 240px;">План</th>
        <th class="center" style="width: 240px;">Прогноз</th>
      </tr>
    </thead>
    <tbody>
      <tr class="critical">
        <td class="center" style="width: 40px;">{{S3_R1_NUM}}</td>
        <td class="center" style="width: 90px;">{{S3_R1_CODE}}</td>
        <td class="left"   style="width: 952px;">{{S3_R1_NAME}}</td>
        <td class="center" style="width: 240px;">{{S3_R1_PLAN}}</td>
        <td class="center" style="width: 240px;">{{S3_R1_FORECAST}}</td>
      </tr>
    </tbody>
  </table>

  <!-- Repeat per section: tbl-section-4, 5, 6, 7 -->
  <!-- (omitted here for brevity — copy structure above and recalibrate widths per table) -->

  <div class="report-footer" id="report-footer">{{FOOTER}}</div>

</div>

</body>
</html>